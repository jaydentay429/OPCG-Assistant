# 复制本文件为 `.env` 后按需填写（不要把 `.env` 提交到公开仓库）。

# --- FastAPI（app.py）---
# 对外暴露的 API 根 URL（用于生成的 packs 链接等），勿带尾部斜杠。
# API_BASE_URL=https://api.example.com

# 卡图 CDN（Cloudflare R2 自定义域名等）。对象为 bucket 根目录下的文件名时设置；未设置则用上面 API 的 `/packs`。
# OPCG_PACKS_PUBLIC_URL=https://img.example.com

# 可选：已从 VPS 删除本地 packs 时，需提供 R2 文件名清单（每行一个文件名，或 `rclone ls` 的输出）。
# 默认若存在 meta/pack_files_r2.txt 会自动加载；也可指定路径：OPCG_PACKS_MANIFEST=/opt/opcg/app/meta/pack_files_r2.txt
# 生成本清单（在项目根目录执行）：
#   rclone ls opcg-r2:你的bucket名 | awk '{print $2}' > meta/pack_files_r2.txt


# 浏览器请求 API 时允许的 Origin（逗号分隔；须含协议与域名，不要路径）。
# 生产部署建议填写，例如：
# OPCG_CORS_ORIGINS=https://app.example.com,https://www.example.com
#
# 不设此项时，仅允许常见本地开发 Origin（localhost / 127.0.0.1）。
OPCG_CORS_ORIGINS=

# 危险：仅本地/内测。设为 1 时 FastAPI 跳过登录检查。生产环境请勿开启。
OPCG_AUTH_BYPASS=

# 会话与重置链接有效期
# AUTH_SESSION_DAYS=30
# AUTH_VERIFY_TOKEN_HOURS=48
# AUTH_RESET_TOKEN_HOURS=2

# 发送验证/重置密码邮件
# 生产（VPS）用 Resend HTTPS；本机可继续用 Gmail SMTP 测。
# RESEND_API_KEY=re_...
# RESEND_FROM=OPCG Assistant <noreply@optcgassistant.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# --- 网站流量统计（前端 beacon → SQLite → 每日邮件）---
# ANALYTICS_ENABLED=1
# ANALYTICS_REPORT_EMAIL=you@example.com
# 把浏览器控制台里打印的 visitor_id、以及日报里的 ip_hash 填进来，排除你自己的测试流量：
# ANALYTICS_EXCLUDE_VISITOR_IDS=
# ANALYTICS_EXCLUDE_USERNAMES=
# ANALYTICS_EXCLUDE_IP_HASHES=
# ANALYTICS_IP_SALT=change-me
# ANALYTICS_ADMIN_TOKEN=optional-secret-for-preview
# 每日邮件（香港时间 00:05 发「昨天」的报告）crontab 示例见 deploy/optcgassistant/run_daily_analytics_email.sh
#   5 16 * * * /opt/opcg/app/deploy/optcgassistant/run_daily_analytics_email.sh

# 前端或脚本如需调用 API，可使用该根地址（无尾部斜杠）。
OPCG_API_BASE_URL=http://127.0.0.1:8000

# 卡组导出图 QR / 重置密码链接等（默认 https://optcgassistant.com）
# OPCG_SITE_URL=https://optcgassistant.com

# 功能开关（默认关闭，上线后可再开）
# OPCG_FEATURE_AI_ADVICE=1
# OPCG_FEATURE_MARKET_PRICE=1

# 可选：Binder 展示墙真实卡册底板 PNG（绝对路径或项目内路径）。不设时优先用 static/binder_pocket_bg.png，否则内置 SVG 九宫格占位底板。
# OPCG_BINDER_BG_IMAGE=/opt/opcg/app/static/binder_pocket_bg.png

