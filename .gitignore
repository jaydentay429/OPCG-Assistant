# --- secrets & local env ---
.env
.env.*
!.env.example
frontend/.env*
!frontend/.env*.example

# --- Python ---
.venv/
.venv_*/
.venv_disabled/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.Python

# --- Node / Next.js ---
frontend/node_modules/
