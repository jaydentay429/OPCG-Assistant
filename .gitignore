frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
frontend/package-lock*.json
!frontend/package-lock.json

# --- large / CDN-hosted assets (keep on VPS + R2, do not push) ---
packs/
preview/images/
!preview/images/.gitkeep

# --- tools / junk ---
rclone*
*.zip
.DS_Store
Documents.code-workspace
.cursor/
opcg_pages/

