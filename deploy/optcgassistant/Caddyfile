# Install: sudo cp Caddyfile /etc/caddy/Caddyfile && sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Requires DNS A records: @, www, api → VPS IP (DNS only).

api.optcgassistant.com {
	encode gzip zstd
	# Retry dialing for up to 15s when this upstream is not accepting connections.
	# An established connection, including a battle WebSocket, is left alone.
	reverse_proxy 127.0.0.1:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Canonical host is apex; keep www as a 301 so sitemap / search stay on one origin.
www.optcgassistant.com {
	redir https://optcgassistant.com{uri} permanent
}

# Primary site: Next.js.
optcgassistant.com {
	# Same dial retry as the API site, for the Next.js restart window.
	reverse_proxy 127.0.0.1:3000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
