# Install: sudo cp Caddyfile /etc/caddy/Caddyfile && sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Requires DNS A records: @, www, api → VPS IP (DNS only).

api.optcgassistant.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000
}

# Canonical host is apex; keep www as a 301 so sitemap / search stay on one origin.
www.optcgassistant.com {
	redir https://optcgassistant.com{uri} permanent
}

# Primary site: Next.js.
optcgassistant.com {
	reverse_proxy 127.0.0.1:3000
}
