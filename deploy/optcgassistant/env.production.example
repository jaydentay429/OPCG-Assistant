# Copy to /opt/opcg/app/.env on the server (chmod 600 .env).

API_BASE_URL=https://api.optcgassistant.com

OPCG_API_BASE_URL=https://api.optcgassistant.com
OPCG_SITE_URL=https://optcgassistant.com
OPCG_CORS_ORIGINS=https://optcgassistant.com,https://www.optcgassistant.com

# Next.js public API base (bake into frontend build)
NEXT_PUBLIC_API_BASE_URL=https://api.optcgassistant.com
NEXT_PUBLIC_PACKS_CDN_URL=https://img.optcgassistant.com

# API: img_local_url + pack_image_public_url (R2 public bucket)
OPCG_PACKS_PUBLIC_URL=https://img.optcgassistant.com

# Legacy Streamlit origin (optional during parallel soak)
# OPCG_STREAMLIT_ORIGIN=https://optcgassistant.com

# Production: leave unset or false.
# OPCG_AUTH_BYPASS=

# Password reset / verify / analytics email
# DigitalOcean blocks Gmail SMTP 587/465 — use Resend HTTPS (api.resend.com:443).
# 1) https://resend.com/api-keys  → create key
# 2) python3 scripts/configure_resend.py --api-key re_...   → add DNS in Cloudflare
# 3) After domain is verified:
RESEND_API_KEY=
RESEND_FROM=OPCG Assistant <noreply@optcgassistant.com>
# AUTH_RESET_TOKEN_HOURS=2
# Optional fallback only (not Gmail 587 on this VPS):
# SMTP_HOST=
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@optcgassistant.com

# Site analytics daily email (HKT yesterday)
# ANALYTICS_ENABLED=1
# ANALYTICS_REPORT_EMAIL=you@example.com
# ANALYTICS_EXCLUDE_VISITOR_IDS=
# ANALYTICS_EXCLUDE_USERNAMES=
# ANALYTICS_EXCLUDE_IP_HASHES=
# ANALYTICS_IP_SALT=change-me-on-server
# ANALYTICS_ADMIN_TOKEN=

# Ranked match appeals (email one-click approve/reject)
# RANK_APPEAL_EMAIL=you@example.com
# RANK_APPEAL_ADMIN_TOKEN=long-random-secret

# Community forum reports
# COMMUNITY_REPORT_EMAIL=you@example.com

# Community reply notifications (email thread author on new reply; set off to disable)
# COMMUNITY_REPLY_EMAIL=on

# Cron (00:05 HKT = 16:05 UTC previous calendar day boundary handled in script):
#   5 16 * * * /opt/opcg/app/deploy/optcgassistant/run_daily_analytics_email.sh

# Optional: absolute path to binder background PNG on this server (else grid fallback).
# OPCG_BINDER_BG_IMAGE=/opt/opcg/app/assets/binder_bg.png

# Photo recognize
# RECOGNIZE_USE_CLIP=1
# CLIP_PREWARM_ON_STARTUP=1
# RECOGNIZE_INCLUDE_DEBUG=0
# CLIP_HIGH_DIST=80
# CLIP_MED_DIST=150
# RECOGNIZE_USE_DEEPSEEK=1
# RECOGNIZE_DEEPSEEK_VISION=0
