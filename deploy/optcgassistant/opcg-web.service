[Unit]
Description=OPCG Next.js frontend
After=network.target opcg-api.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/opcg/app/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/opt/opcg/app/.env
# Prefer standalone output after `npm run build`
ExecStart=/usr/bin/node /opt/opcg/app/frontend/.next/standalone/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
